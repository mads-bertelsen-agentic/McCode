/*******************************************************************************
* Union material backed by one NCrystal configuration.
*
* %I
* Written by: McStas developers
* Origin: McStas Union components
*
* %D
* Creates one NCrystal scattering process and a complete Union material. The
* absorption coefficient is obtained from the same NCrystal configuration, so
* density modifiers such as density=0.6x are applied automatically. Use
* NCrystal_process together with Union_make_material when NCrystal scattering
* must be combined with other Union processes.
* The user does not provide my_absorption for this component.
*
* This component requires Union_init, a Union geometry, and Union_master.
*
* %P
* INPUT PARAMETERS:
* cfg:                    [str]    NCrystal material configuration string (details <a href="https://github.com/mctools/ncrystal/wiki/Using-NCrystal">on this page</a>).
* interact_fraction:      [1]      Fraction of scattering events assigned to this process 0-1 (default -1 lets Union assign it).
* refraction_density:    [g/cm3]  Density of the refracting material. density < 0 means the material is outside/before the shape.
* refraction_sigma_coh:  [barn]   Coherent cross section of the refracting material. Use negative value to indicate a negative coherent scattering length.
* refraction_weight:     [g/mol]  Molar mass of the refracting material.
* refraction_SLD:         [AA^-2] Scattering length density of material (overwrites sigma_coh, density and weight).
* init:                   [string] Name of Union_init component (typically "init", default).
 *******************************************************************************/

DEFINE COMPONENT Union_make_NCrystal_material

SETTING PARAMETERS(string cfg="", interact_fraction=-1,
                   refraction_density=0, refraction_sigma_coh=0,
                   refraction_weight=0, refraction_SLD=-1500,
                   string init="init")
DEPENDENCY "@NCRYSTALFLAGS@"

SHARE
%{
  #ifndef Union
  #error "The Union_init component must be included before this Union_make_NCrystal_material component"
  #endif

  %include "ncrystal_union.c"

  #ifndef MATERIAL_DETECTOR
  #define MATERIAL_DETECTOR dummy
  #endif

  #ifndef UNION_MANUAL_LINKING_FUNCTION
  #define UNION_MANUAL_LINKING_FUNCTION
  int
  manual_linking_function (char* name, char* input_string) {
    char* token;
    int return_integer = 0;
    char local_string[124];

    strcpy (local_string, input_string);
    token = strtok (local_string, ",");
    while (token != NULL) {
      if (strcmp (token, name) == 0)
        return_integer = 1;
      token = strtok (NULL, ",");
    }
    return return_integer;
  }
  #endif
%}

DECLARE
%{
  struct global_material_element_struct global_material_element;
  struct physics_struct this_material;
  struct NCrystal_physics_storage_struct NCrystal_storage;
  struct scattering_process_struct This_process;
  ncrystalsample_t_union params;

  #ifndef PROCESS_DETECTOR
  #define PROCESS_DETECTOR dummy
  #endif
%}

INITIALIZE
%{
  memset (&params, 0, sizeof (params));
  memset (&NCrystal_storage, 0, sizeof (NCrystal_storage));

  if (0 == strcmp (NAME_CURRENT_COMP, "vacuum") || 0 == strcmp (NAME_CURRENT_COMP, "Vacuum")) {
    printf ("ERROR, a Union material may not be called Vacuum. A vacuum volume may be created by material=\"Vacuum\" in a geometry component.\n");
    exit (1);
  }
  if (0 == strcmp (NAME_CURRENT_COMP, "exit") || 0 == strcmp (NAME_CURRENT_COMP, "Exit")) {
    printf ("ERROR, a Union material may not be called Exit. A exit volume may be created by material=\"Exit\" in a geometry component.\n");
    exit (1);
  }
  if (_getcomp_index (init) < 0) {
    fprintf (stderr, "Union_make_NCrystal_material:%s: Error identifying Union_init component, %s is not a known component name.\n", NAME_CURRENT_COMP, init);
    exit (-1);
  }

  ncrystal_union_check_version (NAME_CURRENT_COMP);
  ncrystal_union_setup_conversion (&NCrystal_storage.ncrystal_convfact_vsq2ekin, &NCrystal_storage.ncrystal_convfact_ekin2vsq);
  ncrystal_union_setup_rng ();

  ncrystal_info_t info = ncrystal_create_info (cfg);
  double numberdensity = ncrystal_union_get_numberdensity (info, NAME_CURRENT_COMP);
  double absorption_cross_section = ncrystal_info_getxsectabsorption (info);
  if (absorption_cross_section < 0.0)
    NCMCERR2 (NAME_CURRENT_COMP, "Negative absorption cross section in the loaded NCrystal Info");
  ncrystal_unref (&info);

  params.density_factor = 0.01 / numberdensity;
  params.inv_density_factor = 1.0 / params.density_factor;
  params.scat = ncrystal_create_scatter (cfg);
  params.proc_scat = ncrystal_cast_scat2proc (params.scat);
  params.proc_scat_isoriented = !ncrystal_isnonoriented (params.proc_scat);
  NCrystal_storage.stored_params = params;

  scattering_process_struct_init (&This_process);
  This_process.non_isotropic_rot_index = 1;
  This_process.needs_cross_section_focus = -1;
  This_process.eProcess = NCrystal;
  This_process.data_transfer.pointer_to_a_NCrystal_physics_storage_struct = &NCrystal_storage;
  This_process.probability_for_scattering_function = &NCrystal_physics_my;
  This_process.scattering_function = &NCrystal_physics_scattering;
  sprintf (This_process.name, "%s", NAME_CURRENT_COMP);
  This_process.process_p_interact = interact_fraction;
  rot_copy (This_process.rotation_matrix, ROT_A_CURRENT_COMP);

  this_material.number_of_processes = 1;
  this_material.is_vacuum = 0;
  this_material.any_process_needs_cross_section_focus = -1;
  this_material.p_scattering_array = malloc (sizeof (struct scattering_process_struct));
  if (!this_material.p_scattering_array)
    NCMCERR2 (NAME_CURRENT_COMP, "Unable to allocate the Union material process array");
  this_material.p_scattering_array[0] = This_process;
  this_material.my_a = 100.0 * numberdensity * absorption_cross_section;
  sprintf (this_material.name, "%s", NAME_CURRENT_COMP);

  this_material.has_refraction_info = 0;
  if (refraction_density != 0 || refraction_weight != 0 || refraction_sigma_coh != 0) {
    double refraction_rho, refraction_bc;
    if (refraction_density == 0 || refraction_weight <= 0)
      exit (printf ("Union_make_NCrystal_material: %s: FATAL: invalid material density or molar weight: density=%g weight=%g\n", NAME_CURRENT_COMP,
                    refraction_density, refraction_weight));
    refraction_rho = fabs (refraction_density) * 6.02214179 * 1e23 * 1e-24 / refraction_weight;
    if (refraction_sigma_coh == 0)
      exit (printf ("Union_make_NCrystal_material: %s: FATAL: invalid material coherent cross section: sigma_coh=%g\n", NAME_CURRENT_COMP, refraction_sigma_coh));
    refraction_bc = sqrt (fabs (refraction_sigma_coh) * 100 / 4 / PI) * 1e-5;
    if (refraction_sigma_coh < 0)
      refraction_bc *= -1.0;
    this_material.refraction_scattering_length_density = refraction_rho * refraction_bc;
    this_material.refraction_Qc = 4 * sqrt (PI * refraction_rho * fabs (refraction_bc));
    this_material.has_refraction_info = 1;
  }
  if (refraction_SLD > -1499.0) {
    this_material.refraction_scattering_length_density = refraction_SLD;
    this_material.refraction_Qc = 4.0 * sqrt (PI * fabs (refraction_SLD));
    this_material.has_refraction_info = 1;
  }

  sprintf (global_material_element.name, "%s", NAME_CURRENT_COMP);
  global_material_element.component_index = INDEX_CURRENT_COMP;
  global_material_element.physics = &this_material;
  struct pointer_to_global_material_list* global_material_list = COMP_GETPAR3 (Union_init, init, global_material_list);
  add_element_to_material_list (global_material_list, global_material_element);
%}

TRACE
%{
%}

FINALLY
%{
  ncrystal_unref (&params.scat);
  ncrystal_invalidate (&params.proc_scat);
  free (this_material.p_scattering_array);
%}

END
